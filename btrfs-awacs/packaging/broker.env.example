# Numeric uid/gid of the unprivileged per-user manager allowed to connect.
BTRFS_AWACS_MANAGER_UID=1000
BTRFS_AWACS_MANAGER_GID=1000
# One readable Btrfs subvolume root used only to prove at broker startup that
# the running kernel recognizes BTRFS_IOC_CHANGED_OBJECTS.
BTRFS_AWACS_PROBE_ROOT=/path/to/btrfs/subvolume

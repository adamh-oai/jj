[Unit]
Description=Privileged Btrfs operation broker for AWACS
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=/etc/btrfs-awacs/broker.env
RuntimeDirectory=btrfs-awacs
RuntimeDirectoryMode=0755
# Recreate the volatile request directory before entering ProtectSystem=strict.
# Scope tmpfiles to /tmp and never follow an existing request-directory symlink.
ExecStartPre=+/bin/sh -ec '\
    for manager_id in "$${BTRFS_AWACS_MANAGER_UID}" "$${BTRFS_AWACS_MANAGER_GID}"; do \
        case "$$manager_id" in ""|*[!0-9]*) echo "broker manager uid and gid must be numeric" >&2; exit 1;; esac; \
    done; \
    echo "d /btrfs-awacs-broker 0700 $${BTRFS_AWACS_MANAGER_UID} $${BTRFS_AWACS_MANAGER_GID} -" | /usr/bin/systemd-tmpfiles --root=/tmp --create -'
ExecStart=/opt/awacs/bin/awacs broker-serve /tmp/btrfs-awacs-broker ${BTRFS_AWACS_MANAGER_UID} ${BTRFS_AWACS_MANAGER_GID} ${BTRFS_AWACS_PROBE_ROOT}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
# The startup ioctl probe needs read-only access to the configured Btrfs
# subvolume path. Requests use fanotify-authenticated pidfds and passed fds.
ProtectHome=read-only
# Managers and the broker must see the same request directory.
PrivateTmp=false
RestrictAddressFamilies=none

[Install]
WantedBy=multi-user.target

[Unit]
Description=Privileged Btrfs operation broker for AWACS
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=/etc/btrfs-awacs/broker.env
RuntimeDirectory=btrfs-awacs
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/awacs broker-serve /run/btrfs-awacs/broker.sock ${BTRFS_AWACS_MANAGER_UID} ${BTRFS_AWACS_MANAGER_GID} ${BTRFS_AWACS_PROBE_ROOT}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
# The startup ioctl probe needs read-only access to the configured Btrfs
# subvolume path. Requests use only authenticated passed fds.
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
